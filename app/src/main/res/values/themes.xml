<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Framework theme only: all real styling happens in Compose. This just avoids a white flash on launch. -->
    <style name="Theme.RememberFlow" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/midnight</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/violet</item>
    </style>
</resources>
